# The capabilities registry as a containerised service (development deployment). Two targets:
#   sandbox   the image submitted tools run in: Python 3.12, Node 22, git, no registry code
#   registry  the registry service: the sandbox image plus the docker CLI and this repository's code
# Built by deploy/compose.yaml. Build context: the repository root.
FROM node:22.11.0-bookworm-slim AS node
FROM docker:28.1.1-cli AS dockercli

FROM python:3.12-slim AS sandbox
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN pip install --no-cache-dir pyyaml==6.0.2 jsonschema==4.23.0 cryptography==43.0.3 google-re2==1.1.20251105
ENV PYTHONDONTWRITEBYTECODE=1

FROM sandbox AS registry
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY capability/ capability/
COPY schemas/ schemas/
COPY policy/ policy/
COPY catalog/ catalog/
COPY library/ library/
COPY evidence/ evidence/
# The suite the built-in tools' evidence names: without it they would import as Validated, not Tested.
COPY tests/test_tools_t001.py tests/test_tools_t001.py
COPY deploy/smoke.py deploy/client.py deploy/
ENTRYPOINT ["python", "-m", "capability.registry_cli"]
