{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taffee.local/capabilities/schemas/manifest.agent.schema.json",
  "title": "Agent capability manifest (S-001 §5, minimal; subtype rules are A-003)",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "version", "owner", "summary", "source", "requires", "outcomes", "tools", "roles", "limits"],
  "properties": {
    "kind": { "const": "agent" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "owner": { "type": "string", "pattern": "\\S", "maxLength": 120 },
    "summary": { "type": "string", "pattern": "\\S", "maxLength": 200 },
    "source": { "$ref": "#/$defs/source" },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "minutes"],
      "properties": {
        "turns": { "type": "integer", "minimum": 1, "maximum": 10 },
        "minutes": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    }
  },
  "$defs": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "location"],
          "properties": {
            "type": { "const": "library" },
            "location": { "type": "string", "pattern": "^library/[a-z][a-z0-9-]{1,63}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "repository", "commit", "path", "tree_sha256"],
          "properties": {
            "type": { "const": "external" },
            "repository": { "type": "string", "pattern": "^https://" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "path": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$" },
            "tree_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      ]
    }
  }
}
