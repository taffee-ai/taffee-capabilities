[
  {
    "id": "lists-matches-sorted",
    "input": {
      "pattern": "**/*.ts"
    },
    "files": {
      "b.ts": "",
      "a.ts": "",
      "sub/c.ts": "",
      "sub/d.js": ""
    },
    "expect": {
      "ok": true,
      "contains": "a.ts\\nb.ts\\nsub/c.ts",
      "not_contains": "d.js"
    }
  },
  {
    "id": "directory-prefix-scopes-the-search",
    "input": {
      "pattern": "in/**/*.ts"
    },
    "files": {
      "in/a.ts": "",
      "out/b.ts": ""
    },
    "expect": {
      "ok": true,
      "contains": "in/a.ts",
      "not_contains": "out/b.ts"
    }
  },
  {
    "id": "without-double-star-one-level-only",
    "input": {
      "pattern": "sub/*.ts"
    },
    "files": {
      "sub/a.ts": "",
      "sub/deep/b.ts": ""
    },
    "expect": {
      "ok": true,
      "contains": "sub/a.ts",
      "not_contains": "deep"
    }
  },
  {
    "id": "no-match-is-empty-not-error",
    "input": {
      "pattern": "**/*.nothing"
    },
    "files": {
      "a.ts": ""
    },
    "expect": {
      "ok": true,
      "contains": "\"output\": \"\""
    }
  },
  {
    "id": "missing-pattern-is-an-error-result",
    "input": {},
    "files": {
      "a.ts": ""
    },
    "expect": {
      "ok": false,
      "exit_code": 0
    }
  },
  {
    "id": "parent-directory-is-refused",
    "input": {
      "pattern": "../**/*.txt"
    },
    "files": {
      "a.txt": "x\n"
    },
    "expect": {
      "ok": false,
      "contains": "escapes"
    }
  },
  {
    "id": "escaping-symlink-is-refused",
    "input": {
      "pattern": "link/**/*.txt"
    },
    "files": {
      "a.txt": "x\n"
    },
    "links": {
      "link": "../outside"
    },
    "outside": {
      "secret.txt": "secret\n"
    },
    "expect": {
      "ok": false,
      "contains": "symlink"
    }
  }
]
